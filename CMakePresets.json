{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-win64",
      "displayName": "Visual Studio 2022 Win64",
      "description": "UE-style: CMake/VS files under Intermediate/, runtime under Binaries/Win64/",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/Intermediate",
      "cacheVariables": {
        "CATTY_BUILD_SHARED": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-win64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2022-win64",
      "configuration": "Release"
    },
    {
      "name": "package-release",
      "configurePreset": "vs2022-win64",
      "configuration": "Release",
      "targets": ["Package"]
    }
  ]
}
