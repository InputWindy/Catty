# UE-style generated / local dirs (fully disposable; recreate on generate/build)
/Intermediate/
/Binaries/
/Packaged/
/Cached/
/Saved/

# Logs (runtime + accidental CMake/configure leftovers)
*.log
/CMakeFiles/

# Generated beside .cproject / workspace
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Local CMake / IDE
# Do NOT ignore "build/" — on Windows (case-insensitive) it also hides tracked /Build tooling.
/out/
/cmake-build-*/
/.vs/
CMakeUserPresets.json
compile_commands.json
__pycache__/
*.py[cod]
*$py.class

# Engine-local Python — installed by setup.bat; users must run setup themselves.
# Never commit the interpreter, its installer cache, or pip/download leftovers.
/Tools/python/
/Tools/_cache/
/Tools/**/__pycache__/

# Object / binary artifacts
*.d
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.ilk
*.pdb
*.so
*.dylib
*.dll
*.mod
*.smod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.dwo

# Reflect / Lua codegen (Tools/reflect_codegen.py).
# All C++/JSON outputs live under Catty/Source/Generated/ — wiped by clean.bat.
*.gen.h
*.gen.cpp
*.gen.json
/Catty/Source/Generated/

# Large UI libs are FetchContent'd — do not re-vendor into git.
/Catty/ThirdParty/imgui/
/Catty/ThirdParty/ImGuizmo/
/Catty/ThirdParty/imgui-node-editor/
/Catty/ThirdParty/implot/
/Catty/ThirdParty/ImGuiFileDialog/
/Catty/ThirdParty/IconFontCppHeaders/
