#include <Core/Extension/Render/Render.h>

#include <Core/Application/App.h>
#include <Core/System/Log.h>
#include <Render/RenderServer.h>

namespace Maho
{

struct FRenderSystem::FImpl
{
	FRenderServer RenderServer;
};

FRenderSystem::FRenderSystem()
	: Impl(std::make_unique<FImpl>())
{
}

FRenderSystem::~FRenderSystem() = default;

FRenderServer& FRenderSystem::GetRenderServer() { return Impl->RenderServer; }
const FRenderServer& FRenderSystem::GetRenderServer() const { return Impl->RenderServer; }

bool FRenderSystem::ExecuteStage(EEngineStage Stage)
{
	switch (Stage)
	{
	case EEngineStage::Init:
	{
		if (!GApp)
		{
			MAHO_CORE_ERROR("FRenderSystem: GApp is null");
			return false;
		}

		FPlatformSystem* Platform = GApp->GetExtension<FPlatformSystem>();
		if (!Platform || !Platform->GetWindow())
		{
			MAHO_CORE_ERROR("FRenderSystem: platform window unavailable");
			return false;
		}

		FRenderServer& Server = Impl->RenderServer;
		Server.ShaderSearchPaths = {
			GApp->GetConfig().EngineShadersDir,
			GApp->GetConfig().ProjectShadersDir
		};

		const FConfig& Config = GApp->GetConfig();

		if (!Server.Initialize(
				Config.bCreateMainWindow ? Platform->GetWindow()->GetToolkitWindowHandle() : nullptr,
				Config.WindowWidth,
				Config.WindowHeight,
				Config.ClearColorR,
				Config.ClearColorG,
				Config.ClearColorB,
				Config.ClearColorA))
		{
			MAHO_CORE_ERROR("FRenderSystem: RenderServer.Initialize failed");
			return false;
		}

		return true;
	}
	case EEngineStage::BeginFrame:
	{
		Impl->RenderServer.BeginFrame();
		return true;
	}
	case EEngineStage::EndFrame:
	{
		Impl->RenderServer.EndFrame();
		return true;
	}
	default:
		return true;
	}
}

} // namespace Maho
