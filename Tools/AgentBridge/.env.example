MAHO_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_me
MAHO_AI_MODEL=deepseek-v4-flash

# World execution remains offline unless remote is explicitly selected.
MAHO_WORLD_ADAPTER=mock
MAHO_WORLD_BASE_URL=http://127.0.0.1:8770
MAHO_WORLD_TIMEOUT_MS=5000
MAHO_WORLD_AUTH_TOKEN=replace_me
MAHO_WORLD_ALLOW_NON_LOOPBACK=0
