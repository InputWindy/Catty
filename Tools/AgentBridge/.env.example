CATTY_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_me
CATTY_AI_MODEL=deepseek-v4-flash

# World execution remains offline unless remote is explicitly selected.
CATTY_WORLD_ADAPTER=mock
CATTY_WORLD_BASE_URL=http://127.0.0.1:8770
CATTY_WORLD_TIMEOUT_MS=5000
CATTY_WORLD_AUTH_TOKEN=replace_me
CATTY_WORLD_ALLOW_NON_LOOPBACK=0
