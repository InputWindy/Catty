{
  "suite": "multi-turn references",
  "cases": [
    {
      "name": "pronoun follows a created entity through its lifecycle",
      "turns": [
        {
          "message": "生成一个红色立方体",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 1,
            "entity_count": 1
          }
        },
        {
          "message": "把它移动到 3, 1, 5",
          "expect": {
            "tool_names": ["entity.set_transform"],
            "revision": 2,
            "entity": {
              "name": "cube_1",
              "transform": {
                "position": [3, 1, 5]
              }
            }
          }
        },
        {
          "message": "把它放大两倍",
          "expect": {
            "tool_names": ["entity.set_transform"],
            "revision": 3,
            "entity": {
              "name": "cube_1",
              "transform": {
                "scale": [2, 2, 2]
              }
            }
          }
        },
        {
          "message": "把它变成蓝色",
          "expect": {
            "tool_names": ["entity.set_property"],
            "revision": 4,
            "entity": {
              "name": "cube_1",
              "properties": {
                "color": [0, 0, 1, 1]
              }
            }
          }
        },
        {
          "message": "删除它",
          "expect": {
            "tool_names": ["entity.destroy"],
            "revision": 5,
            "entity_count": 0
          }
        }
      ],
      "final": {
        "revision": 5,
        "entity_count": 0
      }
    },
    {
      "name": "an explicit query replaces the recent reference",
      "initial_entities": [
        {
          "primitive_type": "cube",
          "name": "First"
        },
        {
          "primitive_type": "sphere",
          "name": "Second"
        }
      ],
      "turns": [
        {
          "message": "查询 First",
          "expect": {
            "tool_names": ["entity.get"],
            "revision": 0
          }
        },
        {
          "message": "把它变成红色",
          "expect": {
            "tool_names": ["entity.set_property"],
            "revision": 1,
            "entity": {
              "name": "First",
              "properties": {
                "color": [1, 0, 0, 1]
              }
            }
          }
        }
      ]
    }
  ]
}
