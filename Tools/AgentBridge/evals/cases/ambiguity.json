{
  "suite": "ambiguity and clarification",
  "cases": [
    {
      "name": "delete pronoun with no entities",
      "turns": [
        {
          "message": "删除它",
          "expect": {
            "clarifies": true,
            "tool_call_count": 0,
            "revision": 0,
            "undo_created": false
          }
        }
      ]
    },
    {
      "name": "move pronoun with no entities",
      "turns": [
        {
          "message": "把它移动到 1, 2, 3",
          "expect": {
            "clarifies": true,
            "revision": 0,
            "undo_created": false
          }
        }
      ]
    },
    {
      "name": "color pronoun with no entities",
      "turns": [
        {
          "message": "把它变成红色",
          "expect": {
            "clarifies": true,
            "revision": 0,
            "undo_created": false
          }
        }
      ]
    },
    {
      "name": "generic pronoun with multiple entities",
      "initial_entities": [
        {
          "primitive_type": "cube",
          "name": "One"
        },
        {
          "primitive_type": "sphere",
          "name": "Two"
        }
      ],
      "turns": [
        {
          "message": "删除那个",
          "expect": {
            "clarifies": true,
            "revision": 0,
            "entity_count": 2
          }
        },
        {
          "message": "把它变红",
          "expect": {
            "clarifies": true,
            "revision": 0,
            "entity_count": 2
          }
        }
      ]
    },
    {
      "name": "duplicate primitive target",
      "initial_entities": [
        {
          "primitive_type": "cube",
          "name": "Left"
        },
        {
          "primitive_type": "cube",
          "name": "Right"
        }
      ],
      "turns": [
        {
          "message": "把方块移走",
          "expect": {
            "clarifies": true,
            "revision": 0,
            "entity_count": 2
          }
        }
      ]
    },
    {
      "name": "duplicate exact entity name",
      "initial_entities": [
        {
          "primitive_type": "cube",
          "name": "Same"
        },
        {
          "primitive_type": "sphere",
          "name": "Same"
        }
      ],
      "turns": [
        {
          "message": "删除 Same",
          "expect": {
            "clarifies": true,
            "revision": 0,
            "entity_count": 2
          }
        }
      ]
    }
  ]
}
