{
  "suite": "relative and compound updates",
  "cases": [
    {
      "name": "four directional moves use current transform",
      "turns": [
        {
          "message": "生成一个立方体",
          "expect": {
            "revision": 1
          }
        },
        {
          "message": "向右移动 2",
          "expect": {
            "tool_names": ["entity.set_transform"],
            "revision": 2,
            "entity": {
              "name": "cube_1",
              "transform": {
                "position": [2, 0, 0]
              }
            }
          }
        },
        {
          "message": "向左移动 2",
          "expect": {
            "tool_names": ["entity.set_transform"],
            "revision": 3,
            "entity": {
              "name": "cube_1",
              "transform": {
                "position": [0, 0, 0]
              }
            }
          }
        },
        {
          "message": "向上移动 1",
          "expect": {
            "tool_names": ["entity.set_transform"],
            "revision": 4,
            "entity": {
              "name": "cube_1",
              "transform": {
                "position": [0, 0, 1]
              }
            }
          }
        },
        {
          "message": "向下移动 1",
          "expect": {
            "tool_names": ["entity.set_transform"],
            "revision": 5,
            "entity": {
              "name": "cube_1",
              "transform": {
                "position": [0, 0, 0]
              }
            }
          }
        }
      ]
    },
    {
      "name": "scale color and visibility updates",
      "turns": [
        {
          "message": "生成一个白色立方体",
          "expect": {
            "revision": 1
          }
        },
        {
          "message": "把它放大两倍",
          "expect": {
            "revision": 2,
            "entity": {
              "name": "cube_1",
              "transform": {
                "scale": [2, 2, 2]
              }
            }
          }
        },
        {
          "message": "把它缩小一半",
          "expect": {
            "revision": 3,
            "entity": {
              "name": "cube_1",
              "transform": {
                "scale": [1, 1, 1]
              }
            }
          }
        },
        {
          "message": "把它变成红色",
          "expect": {
            "revision": 4,
            "entity": {
              "name": "cube_1",
              "properties": {
                "color": [1, 0, 0, 1]
              }
            }
          }
        },
        {
          "message": "隐藏它",
          "expect": {
            "revision": 5,
            "entity": {
              "name": "cube_1",
              "properties": {
                "visible": false
              }
            }
          }
        },
        {
          "message": "显示它",
          "expect": {
            "revision": 6,
            "entity": {
              "name": "cube_1",
              "properties": {
                "visible": true
              }
            }
          }
        }
      ]
    },
    {
      "name": "compound spawn uses one tool call",
      "turns": [
        {
          "message": "生成一个红色立方体，放在 3, 1, 5",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "tool_call_count": 1,
            "revision": 1,
            "entity": {
              "name": "cube_1",
              "transform": {
                "position": [3, 1, 5]
              },
              "properties": {
                "color": [1, 0, 0, 1]
              }
            }
          }
        }
      ]
    },
    {
      "name": "English compound sphere spawn",
      "turns": [
        {
          "message": "create a blue sphere at 0, 2, 0",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "tool_call_count": 1,
            "revision": 1,
            "entity": {
              "name": "sphere_1",
              "transform": {
                "position": [0, 2, 0]
              },
              "properties": {
                "color": [0, 0, 1, 1]
              }
            }
          }
        }
      ]
    }
  ]
}
