{
  "suite": "basic commands",
  "cases": [
    {
      "name": "spawn one cube",
      "turns": [
        {
          "message": "生成一个立方体",
          "expect": {
            "assistant_includes": "立方体",
            "tool_names": ["entity.spawn_primitive"],
            "tool_call_count": 1,
            "revision": 1,
            "entity_count": 1,
            "undo_created": true
          }
        }
      ],
      "final": {
        "revision": 1,
        "entity_count": 1,
        "entities": [
          {
            "name": "cube_1",
            "primitive_type": "cube",
            "transform": {
              "position": [0, 0, 0],
              "scale": [1, 1, 1]
            }
          }
        ]
      }
    },
    {
      "name": "spawn a red cube",
      "turns": [
        {
          "message": "生成一个红色立方体",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 1,
            "entity": {
              "name": "cube_1",
              "properties": {
                "color": [1, 0, 0, 1]
              }
            }
          }
        }
      ],
      "final": {
        "entity_count": 1
      }
    },
    {
      "name": "list query delete and undo",
      "turns": [
        {
          "message": "生成一个立方体",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 1
          }
        },
        {
          "message": "列出所有实体",
          "expect": {
            "tool_names": ["world.query_entities"],
            "revision": 1,
            "revision_delta": 0,
            "undo_created": false
          }
        },
        {
          "message": "查询 cube_1",
          "expect": {
            "tool_names": ["entity.get"],
            "revision": 1
          }
        },
        {
          "message": "删除 cube_1",
          "expect": {
            "tool_names": ["entity.destroy"],
            "revision": 2,
            "entity_count": 0
          }
        },
        {
          "message": "撤销刚才的操作",
          "expect": {
            "tool_names": ["history.undo"],
            "revision": 3,
            "entity_count": 1
          }
        }
      ],
      "final": {
        "revision": 3,
        "entity_count": 1
      }
    },
    {
      "name": "Chinese red cube wording variants",
      "turns": [
        {
          "message": "来个红色立方体",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 1,
            "entity": {
              "name": "cube_1",
              "properties": {
                "color": [1, 0, 0, 1]
              }
            }
          }
        }
      ]
    },
    {
      "name": "mixed-language red cube",
      "turns": [
        {
          "message": "创建一个 red cube",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 1,
            "entity_count": 1
          }
        }
      ]
    },
    {
      "name": "English red cube list delete and undo",
      "turns": [
        {
          "message": "create a red cube",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 1
          }
        },
        {
          "message": "list all entities",
          "expect": {
            "tool_names": ["world.query_entities"],
            "revision": 1,
            "revision_delta": 0
          }
        },
        {
          "message": "delete the cube",
          "expect": {
            "tool_names": ["entity.destroy"],
            "revision": 2,
            "entity_count": 0
          }
        },
        {
          "message": "undo the last action",
          "expect": {
            "tool_names": ["history.undo"],
            "revision": 3,
            "entity_count": 1
          }
        }
      ]
    },
    {
      "name": "all primitive types and colors",
      "turns": [
        {
          "message": "创建一个绿色球体",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 1
          }
        },
        {
          "message": "create a blue cylinder",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 2
          }
        },
        {
          "message": "生成一个白色平面",
          "expect": {
            "tool_names": ["entity.spawn_primitive"],
            "revision": 3,
            "entity_count": 3
          }
        }
      ],
      "final": {
        "entity_count": 3,
        "entities": [
          {
            "name": "sphere_1",
            "primitive_type": "sphere",
            "properties": {
              "color": [0, 1, 0, 1]
            }
          },
          {
            "name": "cylinder_2",
            "primitive_type": "cylinder",
            "properties": {
              "color": [0, 0, 1, 1]
            }
          },
          {
            "name": "plane_3",
            "primitive_type": "plane",
            "properties": {
              "color": [1, 1, 1, 1]
            }
          }
        ]
      }
    }
  ]
}
